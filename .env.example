# Google Cloud Translation API key (https://console.cloud.google.com/apis/credentials)
GOOGLE_TRANSLATE_API_KEY=your_google_api_key

# OpenAI API key for Whisper transcription (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/twi_translator
# Or run: npx prisma dev (creates local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twi_translator

# Server port (default: 3001)
PORT=3001

# Redis URL (default: redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# Environment: production | staging | development
# NODE_ENV=production

# Production: comma-separated allowed CORS origins (REQUIRED in production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://portal.yourdomain.com

# Better Auth secret (generate with: npx @better-auth/cli@latest secret)
BETTER_AUTH_SECRET=your-secret-here

# Better Auth base URL (your server's public URL)
BETTER_AUTH_URL=http://localhost:3001

# Portal URL (admin dashboard; for "Open portal dashboard" link)
# Local dev: http://localhost:5174 | Staging: https://test.graviticreatives.com/portal
VITE_PORTAL_URL=http://localhost:5174

# SMTP for email verification & password reset (optional in dev - logs to console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=KyereAse <noreply@yourdomain.com>

# Admin notification email (receives alerts for new reviewer applications, etc.)
# ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# Optional: override AI model names for A/B testing or cost control
# OPENAI_TRANSLATION_MODEL=gpt-4o
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_DIARIZE_MODEL=gpt-4o-transcribe-diarize
# OPENAI_TTS_MODEL=tts-1
