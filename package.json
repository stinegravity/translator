{
  "name": "kyerease",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build": "vite build",
    "build:portal": "vite build --config vite.portal.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "server": "tsx server/src/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "start": "NODE_ENV=production npm run build && NODE_ENV=production tsx server/src/server.ts",
    "deploy": "./scripts/deploy-kyerease.sh",
    "deploy:nginx-ssl": "./scripts/deploy-nginx-ssl.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/node": "^10.45.0",
    "better-auth": "^1.5.4",
    "bull": "^4.16.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^12.35.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.2",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-window": "^2.2.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.12.1",
    "ytdl-core": "^4.11.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.4.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prisma": "^7.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.1"
  }
