# Staging: test.graviticreatives.com
# Copy to .env.staging on server and fill in secrets
# Usage: ecosystem.config.cjs loads this before starting the app

NODE_ENV=staging

# Kyerease DB (docker-compose.kyerease-db.yml, port 5434)
DATABASE_URL=postgresql://kyerease:kyerease_db_password@127.0.0.1:5434/twi_translator

# Redis (docker-compose.kyerease-db.yml, port 6380)
REDIS_URL=redis://127.0.0.1:6380

# Server
PORT=3001

# CORS (comma-separated)
ALLOWED_ORIGINS=https://test.graviticreatives.com

# Better Auth (generate: npx @better-auth/cli@latest secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://test.graviticreatives.com

# API keys (at least one required for translation)
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Portal URL (for "Open portal dashboard" link in main app)
VITE_PORTAL_URL=https://test.graviticreatives.com/portal

# SMTP (optional; if unset, emails log to console)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM=support@app.graviticreatives.com
# ADMIN_NOTIFY_EMAIL=admin@example.com
