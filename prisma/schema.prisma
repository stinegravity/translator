generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TranslationHistory {
  id        String   @id @default(cuid())
  source    String
  target    String
  input     String
  output    String
  mode      String   // "text" | "audio"
  createdAt DateTime @default(now())
}
